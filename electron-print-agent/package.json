{
    "name": "resto-pos-print-agent",
    "version": "1.1.3",
    "description": "Windows Print Agent for Resto POS Webhook",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder",
        "build:win": "electron-builder --win"
    },
    "author": "Antigravity",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.0",
        "electron-store": "^8.1.0",
        "node-thermal-printer": "^4.1.2",
        "get-pixels": "^3.3.3",
        "escpos": "^3.0.0-alpha.6",
        "escpos-usb": "^3.0.0-alpha.4",
        "escpos-network": "^3.0.0-alpha.4"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "build": {
        "appId": "com.restopos.printagent",
        "productName": "Resto POS Print Agent",
        "mac": {
            "target": "dmg"
        },
        "win": {
            "target": "nsis",
            "icon": "assets/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": true
        },
        "files": [
            "**/*",
            "assets/*"
        ]
    }
}